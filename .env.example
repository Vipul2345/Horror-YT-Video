# ============================================================
# HORROR YOUTUBE VIDEO AUTOMATION PLATFORM - CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. GOOGLE GEMINI API CREDENTIALS
# ------------------------------------------------------------
# IMPORTANT NOTICE REGARDING GOOGLE SUBSCRIPTIONS:
# The Jio 18-month Google AI Pro subscription provides consumer access
# to Gemini Advanced via gemini.google.com.
# Developer programmatic automation requires an API key from Google AI Studio:
# Obtain your free/developer API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# 2. MODEL CONFIGURATION (Verified Current Generation)
# ------------------------------------------------------------
STORY_MODEL=gemini-3.8-flash
VOICE_MODEL=gemini-3.1-flash-tts-preview
IMAGE_MODEL=gemini-3.1-flash-image
VIDEO_MODEL=gemini-omni-1.1-flash

# ------------------------------------------------------------
# 3. YOUTUBE OAUTH 2.0 CREDENTIALS (Required for V1 upload)
# ------------------------------------------------------------
# Obtain via Google Cloud Console -> APIs & Services -> Credentials
# Enable "YouTube Data API v3" and create OAuth 2.0 Web/Desktop credentials
YOUTUBE_CLIENT_ID=your_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token_here
YOUTUBE_PRIVACY_STATUS=private

# ------------------------------------------------------------
# 4. INSTAGRAM & FACEBOOK ADAPTERS (Optional / V2 Placeholders)
# ------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=

# ------------------------------------------------------------
# 5. SAFETY & BUDGET LIMITS (Cost Protection)
# ------------------------------------------------------------
# Modes: TEST (100% mock assets, $0), BALANCED (Hybrid), QUALITY (Max video)
COST_MODE=TEST
MAX_VEO_SECONDS=40
MAX_VEO_SCENES=5
MAX_TOTAL_SCENES=45
TARGET_DURATION_SECONDS=330

# ------------------------------------------------------------
# 6. LOCAL DIRECTORIES
# ------------------------------------------------------------
OUTPUT_DIRECTORY=./output
JOBS_DIRECTORY=./jobs
